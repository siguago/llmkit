# 复制成 .env 填入你自己的 key（.env 已被 .gitignore 忽略，不会误提交）
#
#   cp .env.example .env
#   go run ./cmd/llmkit-probe deepseek        # 实测这家支持什么
#
# 只需填你要用的那几家；未填的会被自动跳过。
# 完整列表: go run ./cmd/llmkit-probe -list
#
# 谁会读这个文件：
#   · llmkit-probe   自动读当前目录的 .env
#   · SDK 本身       不读 .env。只在你没传 WithAPIKey 时，去读下面这些
#                    API key 环境变量（需由 shell 导出或你的配置库加载）

# ─────────────────────────────────────────────────────────────
# 厂商凭据
# ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# MINIMAX_API_KEY=
# SILICONFLOW_API_KEY=
# DASHSCOPE_API_KEY=
# VOLCENGINE_API_KEY=

# 托管开源权重模型的推理平台
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=

# 聚合网关
# OPENROUTER_API_KEY=
# EASYROUTER_API_KEY=
# VERCEL_AI_GATEWAY_KEY=

# ─────────────────────────────────────────────────────────────
# 本地 / 自建运行时：默认无鉴权，不填也能用
# ─────────────────────────────────────────────────────────────
# 只在你把运行时挡在校验 bearer token 的代理后面时才需要填。
# 留空时 SDK 一个凭据头都不发。
#
# llmkit-probe 不会在「探测所有已配置厂商」时带上这两家（没法知道本地服务是否
# 起着），按名字显式探测：go run ./cmd/llmkit-probe ollama
# OLLAMA_API_KEY=
# VLLM_API_KEY=
#
# 默认地址 ollama=http://localhost:11434/v1  vllm=http://localhost:8000/v1
# 改地址用 WithBaseURL，或 llmkit-probe -base-url

# ─────────────────────────────────────────────────────────────
# 网络
# ─────────────────────────────────────────────────────────────
# 出站请求走 http.ProxyFromEnvironment，所以标准代理变量开箱可用。
# 国内直连 OpenAI / Anthropic / Gemini 通常需要这个。
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────
# examples/production 用到的（这是示例自己的变量名，SDK 不读它）
# ─────────────────────────────────────────────────────────────
# 中转站 / 私有部署 / 区域端点；留空则用厂商默认地址
# LLM_BASE_URL=

# ─────────────────────────────────────────────────────────────
# 覆盖 llmkit-probe 的默认模型（可选）
# 格式 LLMKIT_MODEL_<厂商大写>，厂商名里的 - 换成 _
# ─────────────────────────────────────────────────────────────
# LLMKIT_MODEL_DEEPSEEK=deepseek-v4-pro
# LLMKIT_EMBED_MODEL_SILICONFLOW=BAAI/bge-m3
# LLMKIT_IMAGE_MODEL_OPENAI=gpt-image-1

# 覆盖集成测试（go test -tags=integration）的模型
# LLMKIT_TEST_MODEL_DEEPSEEK=deepseek-v4-flash
# LLMKIT_TEST_EMBED_MODEL_SILICONFLOW=BAAI/bge-m3
