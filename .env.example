# llmkit-probe 会自动读取本目录下的 .env（该文件已被 .gitignore 忽略）
#
#   cp .env.example .env   然后填入你自己的 key
#   go run ./cmd/llmkit-probe deepseek
#
# 只需填你要测的那几家；未填的会被自动跳过。
# 完整列表: go run ./cmd/llmkit-probe -list

DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# MINIMAX_API_KEY=
# SILICONFLOW_API_KEY=
# DASHSCOPE_API_KEY=
# VOLCENGINE_API_KEY=
# OPENROUTER_API_KEY=
# EASYROUTER_API_KEY=
# VERCEL_AI_GATEWAY_KEY=

# 覆盖默认模型（可选）
# LLMKIT_MODEL_DEEPSEEK=deepseek-reasoner
# LLMKIT_EMBED_MODEL_SILICONFLOW=BAAI/bge-m3
# LLMKIT_IMAGE_MODEL_OPENAI=gpt-image-1
